<Window x:Class="CodexQuota.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="174" Height="42"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Root" Margin="4" Opacity="0" RenderTransformOrigin="0.5,0.5"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseRightButtonUp="Root_MouseRightButtonUp"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
          ToolTipService.InitialShowDelay="220" ToolTipService.ShowDuration="60000">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootTranslate" Y="4" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.ToolTip>
            <ToolTip Background="Transparent" BorderThickness="0" Padding="0"
                     Placement="Top" VerticalOffset="-8" HasDropShadow="True">
                <Border Background="#F5090F1A" BorderBrush="#5C4A5974" BorderThickness="1"
                        CornerRadius="9" Padding="11,8">
                    <StackPanel MaxWidth="290">
                        <TextBlock x:Name="DetailStatusText" Text="正在同步" Foreground="#6EDCB9"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailValueText" Text="等待额度数据" Foreground="#D8E3F2"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ToolTip>
        </Grid.ToolTip>

        <Border x:Name="Shell" CornerRadius="17" BorderThickness="1" Padding="12,0"
                BorderBrush="#6843516B">
            <Border.Background>
                <SolidColorBrush x:Name="ShellBackground" Color="#F20A101B" />
            </Border.Background>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="DividerColumn" Width="21" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ShortGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="5h" Foreground="#7FC8DA" FontSize="10.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ShortValueText" Text="--" Foreground="#34CFF3"
                               FontSize="13.5" FontWeight="Bold" Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="Divider" Grid.Column="1" Width="1" Height="14"
                        Background="#3E5B6880" HorizontalAlignment="Center" />

                <StackPanel x:Name="WeekGroup" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="WeekLabelText" Text="7d" Foreground="#B796D4"
                               FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="WeekValueText" Text="--" Foreground="#C55AF5"
                               FontSize="13.5" FontWeight="Bold" Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
