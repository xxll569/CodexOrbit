<Window x:Class="CodexQuota.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Orbit Mini"
        Width="188" Height="68"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Root" Opacity="0" ClipToBounds="True"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseRightButtonUp="Root_MouseRightButtonUp"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
          ToolTipService.InitialShowDelay="260" ToolTipService.ShowDuration="60000">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="4" />
        </Grid.RenderTransform>

        <Grid.ToolTip>
            <ToolTip Background="Transparent" BorderThickness="0" Padding="0"
                     Placement="Top" VerticalOffset="-8" HasDropShadow="True">
                <Border Background="#F5090F1A" BorderBrush="#5C4A5974" BorderThickness="1"
                        CornerRadius="9" Padding="11,8">
                    <StackPanel MaxWidth="290">
                        <TextBlock x:Name="DetailStatusText" Text="正在同步" Foreground="#6EDCB9"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailValueText" Text="等待额度数据" Foreground="#D8E3F2"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ToolTip>
        </Grid.ToolTip>

        <Grid x:Name="ExpandedContent" Width="188" Height="68"
              HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="PillShell" Width="138" Height="50"
                    Margin="2,9,0,9" HorizontalAlignment="Left"
                    CornerRadius="25" BorderThickness="1" BorderBrush="#6843516B"
                    Padding="15,0,36,0">
                <Border.Background>
                    <SolidColorBrush x:Name="PillBackground" Color="#F20A101B" />
                </Border.Background>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="5h" Foreground="#7FC8DA" FontSize="10.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShortValueText" Text="--" Foreground="#34CFF3"
                                   FontSize="15" FontWeight="Bold" Margin="6,-1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ShortResetText" Text="等待同步" Foreground="#7899AB"
                               FontSize="9.5" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="GaugeShell" Width="68" Height="68"
                    HorizontalAlignment="Right" CornerRadius="34"
                    BorderThickness="1" BorderBrush="#764B5D80">
                <Border.Background>
                    <SolidColorBrush x:Name="GaugeBackground" Color="#F6090F1A" />
                </Border.Background>
                <Grid>
                    <Canvas Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="54" Height="54"
                                 Stroke="#342A3550" StrokeThickness="5" />
                        <Path x:Name="GaugeProgressPath" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22D7F4" Offset="0" />
                                    <GradientStop Color="#3D7BFF" Offset="0.48" />
                                    <GradientStop Color="#B946F5" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                    </Canvas>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="GaugeValueText" Text="--" Foreground="#F3F7FC"
                                   FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GaugeLabelText" Text="同步" Foreground="#7894B6"
                                   FontSize="8.5" Margin="0,-2,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="CollapsedHandle" Width="14" Height="52"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" Opacity="0">
            <Border CornerRadius="7" Background="#F20A101B"
                    BorderBrush="#76536486" BorderThickness="1">
                <Border Width="4" Height="38" CornerRadius="2"
                        Background="#342A3550" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Border x:Name="HandleProgress" Width="4" Height="24"
                                VerticalAlignment="Bottom" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22D7F4" Offset="0" />
                                    <GradientStop Color="#3D7BFF" Offset="0.5" />
                                    <GradientStop Color="#B946F5" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
